<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/app_name">

    <Preference android:key="hero" android:selectable="false"
        app:layout="@layout/hero_preference"
        app:allowDividerAbove="false" app:allowDividerBelow="false" />

    <PreferenceCategory android:title="@string/category_apple">
        <SwitchPreferenceCompat android:key="airpods_switching"
            android:persistent="false"
            app:layout="@layout/feature_card"
            app:allowDividerAbove="false" app:allowDividerBelow="false"
            android:icon="@drawable/ic_feature_airpods"
            android:title="@string/airpods_title"
            android:summary="@string/airpods_summary" />
        <SwitchPreferenceCompat android:key="iphone_notifications"
            android:persistent="false"
            app:layout="@layout/feature_card"
            app:allowDividerAbove="false" app:allowDividerBelow="false"
            android:icon="@drawable/ic_feature_iphone"
            android:title="@string/iphone_title"
            android:summary="@string/iphone_summary" />
    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="footer"
        android:title="@string/footer" />
</PreferenceScreen>
