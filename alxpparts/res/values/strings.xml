    <string name="hero_title">ALXP Features</string>
    <string name="hero_summary">Extras that make the Pad work with the rest of your devices</string>

    <string name="category_apple">Apple devices</string>

    <string name="airpods_title">AirPods automatic switching</string>
    <string name="airpods_summary">Playing or calling on the Pad moves your AirPods to it, and playing on your iPhone or Mac moves them back. Restarts Bluetooth when changed.</string>
    <string name="airpods_unavailable">Needs the ALXP Bluetooth patch in this ROM</string>

    <string name="iphone_title">iPhone notifications</string>
    <string name="iphone_summary">Shows your iPhone notifications on the Pad. Pair once from the iPhone: Settings &gt; Bluetooth &gt; %1$s.</string>

    <string name="mac_clipboard_title">Mac shared clipboard</string>
    <string name="mac_clipboard_summary">Copy on the Pad, paste on your Mac, and back. Text and images, over your Wi-Fi with ALXP for Mac.</string>
    <string name="mac_display_title">Mac second display</string>
    <string name="mac_display_summary">Use the Pad as an extra Mac display, like Sidecar. Start it from ALXP for Mac; touch and the pen move the pointer.</string>

    <string name="footer">AirPods switching is based on LibrePods.</string>

