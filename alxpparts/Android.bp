// ALXP Features: AirPods switching (trimmed from LibrePods, see UPSTREAM),
// iPhone notifications and the ALXP for Mac link. Built from source with
// the ROM; installed only when the product sets WITH_ALXP_PARTS (see
// product.mk). The Mac side lives in mac/ and is not part of the ROM.
android_app {
    name: "ALXPParts",
    min_sdk_version: "current",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    static_libs: [
        "SettingsLib",
        "androidx.preference_preference",
        "androidx.core_core",
    ],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    optimize: {
        enabled: false,
    },
}
