[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ScaledFbDxe
  FILE_GUID                      = 4B2D8E61-3A7C-4F15-9D0E-6C8A1B5F2E47
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = ScaledFbInitialize

[Sources]
  ScaledFb.c

[Packages]
  ArmPkg/ArmPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  SiliciumPkg/SiliciumPkg.dec

[LibraryClasses]
  BaseMemoryLib
  DebugLib
  FrameBufferBltLib
  MemoryAllocationLib
  MemoryMapHelperLib
  PcdLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[FixedPcd]
  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferWidth
  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferHeight
  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferColorDepth

[Protocols]
  gEfiGraphicsOutputProtocolGuid
  gEfiDevicePathProtocolGuid

[Depex]
  TRUE
