  CacheMaintenanceLib
  DebugLib
  DxeServicesLib
  DevicePathLib
  MemoryAllocationLib
  UefiBootManagerLib
  UefiBootServicesTableLib
  UefiLib
  UefiRuntimeServicesTableLib
  RfsProtectionLib

[Guids]
  gUsbControllerInitGuid
  gSdCardInitGuid
  gUefiShellFileGuid
  gFdtTableGuid
  gEfiFileInfoGuid
  gEfiEventExitBootServicesGuid

[Protocols]
