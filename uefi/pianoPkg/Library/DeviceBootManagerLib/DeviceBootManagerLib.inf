[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = PianoDeviceBootManagerLib
  FILE_GUID                      = 8E3B2D41-7C59-4F1A-B6E2-3D9A5C8F1B07
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = DeviceBootManagerLib|DXE_DRIVER

[Sources]
  DeviceBootManager.c
  PianoMenu.c
  PianoMenu.h
  PianoDtb.c
  PianoFastboot.c
  PianoReset.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MsCorePkg/MsCorePkg.dec
  ShellPkg/ShellPkg.dec
  QcomPkg/QcomPkg.dec

[LibraryClasses]
