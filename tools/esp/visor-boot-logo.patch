diff --git a/src/gui/gui_fade.c b/src/gui/gui_fade.c
index eb91d3c..6a256b1 100644
--- a/src/gui/gui_fade.c
+++ b/src/gui/gui_fade.c
@@ -172,3 +172,22 @@ void gui_crossfade(gui_state_t *state, UINT32 *from, UINT32 *to) {
         if (spent < FADE_MIN_FRAME_US) BS->Stall(FADE_MIN_FRAME_US - spent);
     }
 }
+
+/* Quiet boot: the selected entry's icon, at its menu size and color, alone on
+ * black. The screen keeps it after Visor is gone, until the system draws its
+ * own boot screen. */
+void gui_show_entry_logo(gui_state_t *state, boot_entry_t *entry) {
+    if (!state || !state->backbuffer || !entry || !entry->icon) return;
+    UINTN px = state->screen_width * state->screen_height;
+    fade_write_black(state, px);
+    UINTN is = state->icon_size ? state->icon_size : default_icon_size(state);
+    UINTN ei = entry_icon_size(entry, is);
+    UINTN x = (state->screen_width - ei) / 2;
+    UINTN y = (state->screen_height - ei) / 2;
+    if (state->os_icon_tint_on)
+        draw_image_tinted_a(state, entry->icon, x, y, ei, state->os_icon_tint, 255);
+    else
+        draw_image_sized_a(state, entry->icon, x, y, ei, 255);
+    gui_present(state);
+    state->keep_screen = 1;
+}
