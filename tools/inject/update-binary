#!/sbin/sh
# SPDX-License-Identifier: BSD-2-Clause-Patent
#
# Piano UEFI installer, for OrangeFox and TWRP.
#
# Install: create/update a real ESP, then patch boot_a and boot_b.
# Fresh creation shrinks mounted decrypted F2FS without formatting userdata.
# Uninstall (the ZIP holds a file named "uninstall"): takes them back out of
# both boot images.

OUTFD=$2
ZIP=$3
TMP=/tmp/piano-uefi
ESP_MOUNT=
ESP_OWN_MOUNT=0
ESP_BACKUP=
ESP_UPDATING=0
BACKUP_DIR=/sdcard/piano-uefi/install-$(date +%s)-$$

ui_print() {
	echo "ui_print $1" > /proc/self/fd/$OUTFD
	echo "ui_print" > /proc/self/fd/$OUTFD
}

abort() {
	ui_print "Error: $1"
	if [ "$ESP_UPDATING" = 1 ] && [ -f "$ESP_BACKUP" ]; then
        tar -xf "$ESP_BACKUP" -C "$ESP_MOUNT" || ui_print "ESP rollback failed; backup: $ESP_BACKUP"
        sync
    fi
	[ "$ESP_OWN_MOUNT" != 1 ] || umount "$ESP_MOUNT" 2>/dev/null
    if [ "${mode:-}" = uninstall-reclaim ]; then
        ui_print "Reclaim logs retained in $TMP. Keep the receipt and backups."
    else
        rm -rf $TMP
    fi
	exit 1
}

rm -rf $TMP
mkdir -p $TMP
cd $TMP || abort "no /tmp"
unzip -o "$ZIP" -x 'META-INF/*' >/dev/null || abort "cannot unpack the zip"
chmod 755 $TMP/piano-inject
[ ! -f $TMP/piano-esp ] || chmod 755 $TMP/piano-esp

mode=install
[ -f $TMP/uninstall ] && mode=uninstall
[ -f $TMP/reclaim ] && mode=uninstall-reclaim
ui_print "Piano UEFI: $mode"

device=$(getprop ro.product.device)
[ -z "$device" ] && device=$(getprop ro.build.product)
case "$device" in
piano) ;;
*) abort "this is for the Xiaomi Pad 8 Pro (piano), not '$device'" ;;
esac

if [ "$mode" = uninstall-reclaim ]; then
    . "$TMP/reclaim.sh"
    reclaim_prepare
fi

# Preflight every boot image before any storage mutation.
valid=0
for slot in _a _b; do
    dev=/dev/block/by-name/boot$slot
    [ -e "$dev" ] || continue
    dd if="$dev" of=$TMP/boot$slot.img bs=1M 2>/dev/null || abort "cannot read boot$slot"
    head -c 8 $TMP/boot$slot.img | grep -q 'ANDROID!' || continue
    if [ "$mode" = install ]; then
        $TMP/piano-inject $TMP/boot$slot.img $TMP/selector.bin $TMP/uefi.bin --no-esp $TMP/new$slot.img > $TMP/log 2>&1
    else
        $TMP/piano-inject --remove $TMP/boot$slot.img $TMP/new$slot.img > $TMP/log 2>&1
    fi || abort "boot$slot: $(cat $TMP/log)"
    [ "$(wc -c < $TMP/new$slot.img)" -le "$(blockdev --getsize64 "$dev")" ] || abort "boot$slot: new image does not fit"
    mkdir -p "$BACKUP_DIR" || abort "boot backup storage unavailable"
    cp $TMP/boot$slot.img "$BACKUP_DIR/boot$slot-before-$mode.img" || abort "cannot back up boot$slot"
    valid=1
done
[ "$valid" = 1 ] || abort "no Android boot image found"

if [ "$mode" = install ]; then
    idx=$($TMP/piano-esp inspect /dev/block/sda 2>$TMP/log) || abort "ESP inspection: $(cat $TMP/log)"
    if [ "$idx" = 0 ]; then
        # Backup must survive /tmp cleanup and a reboot. Failure is fatal.
        mkdir -p "$BACKUP_DIR" || abort "persistent GPT backup storage unavailable"
        backup=$BACKUP_DIR/gpt-before-esp.bin
        ui_print "Creating ESP: shrink F2FS, verify, update GPT, install Visor."
        $TMP/piano-esp create /dev/block/sda "$backup" $TMP/esp.img --execute >$TMP/esp-index 2>$TMP/log || abort "ESP creation: $(cat $TMP/log)"
        mkdir -p /data/adb/piano-uefi || abort "Cannot persist ESP ownership receipt"
        chmod 700 /data/adb/piano-uefi || abort "Cannot protect ESP receipt directory"
        cp "$backup.receipt" /data/adb/piano-uefi/esp-reclaim.receipt.new || abort "Cannot persist ESP ownership receipt"
        chmod 600 /data/adb/piano-uefi/esp-reclaim.receipt.new || abort "Cannot protect ESP ownership receipt"
        mv /data/adb/piano-uefi/esp-reclaim.receipt.new /data/adb/piano-uefi/esp-reclaim.receipt || abort "Cannot publish ESP ownership receipt"
        sync
        ui_print "ESP created. GPT backup: $backup"
    else
        espdev=/dev/block/sda$idx
        [ -b "$espdev" ] || abort "ESP node unavailable: reboot recovery and retry"
        ESP_MOUNT=$(awk -v dev="$espdev" '$1 == dev && $3 == "vfat" {print $2; exit}' /proc/mounts)
        if [ -z "$ESP_MOUNT" ]; then
            ESP_MOUNT=$TMP/esp-mount
            mkdir -p "$ESP_MOUNT"
            mount -t vfat -o rw "$espdev" "$ESP_MOUNT" || abort "existing ESP is not mountable FAT; it will not be formatted"
            ESP_OWN_MOUNT=1
        fi
        # A complete backup preserves overwritten boot files for rollback.
        mkdir -p "$BACKUP_DIR" || abort "ESP backup storage unavailable"
        ESP_BACKUP=$BACKUP_DIR/esp-before.tar
        tar -cf "$ESP_BACKUP" -C "$ESP_MOUNT" . || abort "cannot back up ESP"
        need_kb=$(du -sk $TMP/esp | awk '{print $1}')
        free_kb=$(df -k "$ESP_MOUNT" | tail -n 1 | awk '{print $4}')
        case "$free_kb" in ''|*[!0-9]*) abort "cannot determine ESP free space" ;; esac
        [ "$free_kb" -ge "$need_kb" ] || abort "not enough free ESP space"
        ESP_UPDATING=1
        cp -R $TMP/esp/. "$ESP_MOUNT"/ || abort "cannot update Visor"
        sync
        # Verify every copied file, not only the loader.
        (cd $TMP/esp && find . -type f) >$TMP/esp-files
        while IFS= read -r file; do
            cmp "$TMP/esp/$file" "$ESP_MOUNT/$file" >/dev/null 2>&1 || abort "ESP verification failed: $file"
        done <$TMP/esp-files
        if [ "$ESP_OWN_MOUNT" = 1 ]; then
            umount "$ESP_MOUNT" || abort "cannot unmount ESP"
            ESP_OWN_MOUNT=0
        fi
        ESP_UPDATING=0
        ui_print "Visor updated on existing ESP; other files preserved."
    fi
fi

# Both slots, so the UEFI stays after a slot switch.
done_any=0
for slot in _a _b; do
	dev=/dev/block/by-name/boot$slot
	[ -e "$dev" ] || continue
	[ -f $TMP/new$slot.img ] || continue
	new=$(wc -c < $TMP/new$slot.img)

	dd if=$TMP/new$slot.img of="$dev" bs=1M conv=fsync 2>/dev/null || abort "cannot write boot$slot"
	[ "$(head -c "$new" "$dev" | md5sum | cut -d' ' -f1)" = \
	  "$(md5sum < $TMP/new$slot.img | cut -d' ' -f1)" ] || abort "boot$slot: verify failed"
	ui_print "boot$slot: done"
	done_any=1
done
[ $done_any = 1 ] || abort "no Android boot image found"

if [ "$mode" = uninstall-reclaim ]; then
    reclaim_apply
    exit 0
fi

cd /
rm -rf $TMP
if [ $mode = install ]; then
	ui_print "Done. Reboot: Visor starts. Hold volume down at the Mi logo"
	ui_print "for fastboot, volume up for recovery."
else
	ui_print "Done. Old boot images are in $BACKUP_DIR."
fi
exit 0
