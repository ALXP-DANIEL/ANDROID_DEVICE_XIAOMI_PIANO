// Offline Notes port: signed-out account policy, reviewed AI gates and cloud
// entry-point removal. Platform signing is performed by the ROM build.
soong_namespace {}

java_library {
    name: "PianoNotesCompat",
    srcs: ["compat/src/**/*.java"],
    platform_apis: true,
    compile_dex: true,
    installable: false,
    min_sdk_version: "29",
    optimize: { enabled: false },
}

python_binary_host {
    name: "piano-notes-append-compat",
    main: "append-compat.py",
    srcs: ["append-compat.py", "offline_dex.py", "offline_manifest.py", "manifest.py", "strip_micloud.py"],
}

java_binary_host {
    name: "piano-notes-offline-dex",
    srcs: ["OfflineDex.java", "ReplayableDexPool.java"],
    main_class: "OfflineDex",
    static_libs: ["smali-dexlib2"],
}

// A plain genrule requests an empty-variant dependency and cannot consume
// PianoNotesCompat's android_common Java output. Keep the APK appender in the
// Android Java variant so $(location :PianoNotesCompat) is its DEX JAR.
java_genrule {
    name: "piano-notes-compatible-apk",
    srcs: ["prebuilt/MIUINotes.apk", ":PianoNotesCompat", "compat/device_features/piano.xml"],
    tools: ["piano-notes-append-compat", "piano-notes-offline-dex"],
    out: ["MIUINotes-compatible.apk"],
    cmd: "$(location piano-notes-append-compat) $(location prebuilt/MIUINotes.apk) $(location :PianoNotesCompat) $(out) $(location compat/device_features/piano.xml) $(location piano-notes-offline-dex)",
}

android_app_import {
    name: "MIUINotes",
    apk: ":piano-notes-compatible-apk",
    // Default ROM app key: closed-source Notes must not get platform permissions.
    default_dev_cert: true,
    product_specific: true,
    optional_uses_libs: [
        "org.apache.http.legacy",
        "com.miui.system",
        "com.android.extensions.appfunctions",
        "androidx.window.extensions",
        "androidx.window.sidecar",
        "libtflite_interface_wrap.touch.so",
        "libestimate_interface.touch.so",
        "libbrushstroke_interface.touch.so",
        "librecognize_interface.touch.so",
    ],
    enforce_uses_libs: true,
    dex_preopt: { enabled: false },
}
