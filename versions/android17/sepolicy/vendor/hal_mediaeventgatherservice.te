type hal_mediaeventgatherservice_default, domain;
type hal_mediaeventgatherservice_default_exec, exec_type, file_type, vendor_file_type;
type hal_mediaeventgatherservice_service, hal_service_type, service_manager_type;

binder_use(hal_mediaeventgatherservice_default)
binder_use(hal_mediaeventgatherservice_server)
hal_server_domain(hal_mediaeventgatherservice_default, hal_mediaeventgatherservice)
init_daemon_domain(hal_mediaeventgatherservice_default)

allow hal_mediaeventgatherservice_client hal_mediaeventgatherservice_server:binder { call transfer };
allow hal_mediaeventgatherservice_client hal_mediaeventgatherservice_server:fd *;
allow hal_mediaeventgatherservice_client hal_mediaeventgatherservice_service:service_manager find;
allow hal_mediaeventgatherservice_default hal_system_suspend_service:service_manager find;
allow hal_mediaeventgatherservice_server hal_mediaeventgatherservice_client:binder { call transfer };
allow hal_mediaeventgatherservice_server hal_mediaeventgatherservice_client:fd *;
allow hal_mediaeventgatherservice_server hal_mediaeventgatherservice_service:service_manager { add find };
