type hal_misyscore_default, domain;
type hal_misyscore_default_exec, exec_type, file_type, vendor_file_type;
type hal_misyscore_service, hal_service_type, protected_service, service_manager_type;

init_daemon_domain(hal_misyscore_default)
hal_server_domain(hal_misyscore_default, hal_misyscore)
hal_attribute_service(hal_misyscore, hal_misyscore_service)
binder_use(hal_misyscore_default)

allow hal_misyscore_default block_device:dir r_dir_perms;
allow hal_misyscore_default blackbox_block_device:blk_file { getattr open read setattr };
allow hal_misyscore_default minidump_block_device:blk_file { getattr open read setattr };
allow hal_misyscore_default minidump_data_file:dir r_dir_perms;
allow hal_misyscore_default minidump_data_file:file setattr;
allow hal_misyscore_default oops_block_device:blk_file { getattr open read };
allow hal_misyscore_default rescue_block_device:blk_file { getattr open read };
allow hal_misyscore_default secinfo_block_device:blk_file { getattr open read setattr };
allow hal_misyscore_default super_block_device:blk_file { getattr open read };
allow hal_misyscore_default vendor_ramdump_block_device:blk_file { getattr open read setattr };
