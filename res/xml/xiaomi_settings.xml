<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/xiaomi_settings_title">

    <Preference android:key="xiaomi_intro" android:selectable="false"
        app:layout="@layout/features_hero_preference"
        app:allowDividerAbove="false" app:allowDividerBelow="false" />

    <PreferenceCategory android:title="@string/features_accessories">
        <Preference android:key="pen" app:layout="@layout/features_accessory_card"
            android:icon="@drawable/features_pen_illustration"
            android:title="@string/pen_category_title" android:summary="@string/features_pen_summary"
            app:allowDividerAbove="false" app:allowDividerBelow="false">
            <intent android:targetClass="org.lineageos.pianoparts.StylusSettingsActivity" android:targetPackage="org.lineageos.pianoparts" />
        </Preference>
        <Preference android:key="keyboard" app:layout="@layout/features_accessory_card"
            android:icon="@drawable/accessory_keyboard_settings_image_normal_pad"
            android:title="@string/keyboard_cover_title" android:summary="@string/features_keyboard_summary"
            app:allowDividerAbove="false" app:allowDividerBelow="false">
            <intent android:targetClass="org.lineageos.pianoparts.KeyboardSettingsActivity" android:targetPackage="org.lineageos.pianoparts" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_display">

        <Preference
            android:key="color_scheme"
            app:layout="@layout/features_navigation_card"
            app:allowDividerAbove="false" app:allowDividerBelow="false"
            android:icon="@drawable/ic_true_tone_tile"
            android:title="@string/color_scheme_title"
            android:summary="@string/color_scheme_summary">
            <intent
                android:targetClass="org.lineageos.pianoparts.ColorSchemeActivity"
                android:targetPackage="org.lineageos.pianoparts" />
        </Preference>

        <com.android.settingslib.PrimarySwitchPreference
            android:key="reading_mode"
            android:icon="@drawable/ic_reading_tile"
            android:title="@string/reading_mode_title"
            android:summary="@string/reading_mode_summary"
            android:persistent="false">
            <intent
                android:targetClass="org.lineageos.pianoparts.ReadingModeActivity"
                android:targetPackage="org.lineageos.pianoparts" />
        </com.android.settingslib.PrimarySwitchPreference>

        <SwitchPreferenceCompat
            android:key="sunlight_mode"
            android:icon="@drawable/ic_sunlight_tile"
            android:title="@string/sunlight_mode_title"
            android:summary="@string/sunlight_mode_summary"
            android:persistent="false" />

        <ListPreference
            android:key="tap_to_wake"
            android:icon="@drawable/ic_touch_tile"
            android:title="@string/tap_to_wake_title"
            android:summary="%s"
            android:entries="@array/tap_to_wake_entries"
            android:entryValues="@array/tap_to_wake_values"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_performance">

        <SwitchPreferenceCompat
            android:key="thermal_game"
            android:icon="@drawable/ic_thermal_tile"
            android:title="@string/thermal_game_title"
            android:summary="@string/thermal_game_summary"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_battery">

        <SwitchPreferenceCompat
            android:key="bypass_charging"
            android:icon="@drawable/ic_bypass_tile"
            android:title="@string/bypass_charging_title"
            android:summary="@string/bypass_charging_summary"
            android:persistent="false" />

        <Preference
            android:key="battery_protection"
            android:icon="@drawable/ic_bypass_tile"
            app:layout="@layout/features_navigation_card"
            app:allowDividerAbove="false" app:allowDividerBelow="false"
            android:title="@string/battery_protection_title"
            android:summary="@string/battery_protection_summary">
            <intent
                android:targetClass="org.lineageos.pianoparts.BatteryProtectionActivity"
                android:targetPackage="org.lineageos.pianoparts" />
        </Preference>
    </PreferenceCategory>

</PreferenceScreen>
