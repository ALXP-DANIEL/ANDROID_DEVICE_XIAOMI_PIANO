<!-- Like the stock screen_color_preference: the color wheel above the
     Standard, Warm, Cool and Custom tabs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <org.lineageos.pianoparts.ColorPickerView
        android:id="@+id/color_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/color_temperature_title" />

    <RadioGroup
        android:id="@+id/color_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:background="@drawable/color_tabs_background"
        android:orientation="horizontal"
        android:padding="4dp">

        <RadioButton
            android:id="@+id/color_standard"
            style="@style/ColorTab"
            android:text="@string/color_level_standard" />

        <RadioButton
            android:id="@+id/color_warm"
            style="@style/ColorTab"
            android:text="@string/color_level_warm" />

        <RadioButton
            android:id="@+id/color_cool"
            style="@style/ColorTab"
            android:text="@string/color_level_cool" />

        <RadioButton
            android:id="@+id/color_custom"
            style="@style/ColorTab"
            android:text="@string/color_level_custom" />
    </RadioGroup>
</LinearLayout>
