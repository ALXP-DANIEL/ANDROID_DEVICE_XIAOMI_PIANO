<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingHorizontal="16dp" android:paddingTop="8dp" android:paddingBottom="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:background="@drawable/features_hero_background"
        android:paddingHorizontal="24dp" android:paddingTop="24dp" android:paddingBottom="26dp">
        <ImageView android:layout_width="match_parent" android:layout_height="148dp"
            android:src="@drawable/features_pad_illustration" android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/features_hero_title"
            android:gravity="center" android:textSize="26sp" android:fontFamily="sans-serif-medium"
            android:textColor="?android:attr/textColorPrimary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/features_hero_summary"
            android:gravity="center" android:textSize="14sp" android:lineSpacingExtra="3dp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>
</FrameLayout>
