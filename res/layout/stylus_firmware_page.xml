<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="24dp">
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
  android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <ImageView android:layout_width="match_parent" android:layout_height="88dp"
    android:layout_marginBottom="28dp" android:src="@drawable/accessory_stylus_show_icon"
    android:scaleType="fitCenter" android:importantForAccessibility="no" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="@string/stylus_firmware_model" android:textAppearance="?android:attr/textAppearanceSmall" />
   <TextView android:id="@+id/pen_update_model" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:textAppearance="?android:attr/textAppearanceMedium" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="@string/stylus_firmware_current" android:textAppearance="?android:attr/textAppearanceSmall" />
   <TextView android:id="@+id/pen_update_revision" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:textAppearance="?android:attr/textAppearanceMedium" />
   <TextView android:id="@+id/pen_update_status" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:textAppearance="?android:attr/textAppearanceSmall" android:accessibilityLiveRegion="polite" />
   <ProgressBar android:id="@+id/pen_update_progress" style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
    android:max="100" android:visibility="gone" />
  </LinearLayout>
 </ScrollView>
 <Button android:id="@+id/pen_update_check" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="@string/stylus_firmware_check" />
 <Button android:id="@+id/pen_update_start" android:layout_width="match_parent" android:layout_height="50dp"
  android:layout_marginTop="12dp" android:text="@string/stylus_firmware_update" />
</LinearLayout>