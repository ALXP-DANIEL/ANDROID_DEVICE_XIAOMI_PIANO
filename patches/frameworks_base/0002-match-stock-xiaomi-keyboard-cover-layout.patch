+
+    /** The stock .44 compatibility stub disables default selection during CTS mode. */
+    private static boolean isXiaomiKeyboardLayoutCompatibilityMode() {
+        // AOSP lacks Xiaomi's KeyboardLayoutManagerStub.setCompatStatus(boolean).
+        // Expose the equivalent state to ROM/CTS harnesses without altering normal mode.
+        return android.os.SystemProperties.getBoolean(
+                "debug.piano.keyboard_layout_compat", false);
+    }
+
+    private static KeyboardLayoutSelectionResult getXiaomiFallbackLayout(
+            @Nullable InputMethodSubtype subtype) {
+        if (isXiaomiKeyboardLayoutCompatibilityMode() || subtype == null) {
+            return FAILED;
+        }
+        final String languageTag = subtype.getLanguageTag();
+        // Xiaomi matches the legacy underscores; accept canonical BCP-47 forms
+        // as well so the same IME does not fall back to US because of formatting.
+        final String layout = "de_DE".equals(languageTag) || "de-DE".equals(languageTag)
+                ? "keyboard_layout_german"
+                : "fr_FR".equals(languageTag) || "fr-FR".equals(languageTag)
+                ? "keyboard_layout_french" : "keyboard_layout_english_us";
+        return new KeyboardLayoutSelectionResult(
+                "com.android.inputdevices/com.android.inputdevices.InputDeviceReceiver/" + layout,
+                LAYOUT_SELECTION_CRITERIA_DEFAULT);
+    }
+
+    private static boolean shouldSuppressXiaomiKeyboardLayoutNotification(
+            @Nullable InputDevice device) {
+        if (device == null) {
+            return false;
+        }
+        final int vendorId = device.getVendorId();
+        final int productId = device.getProductId();
+        // Stock InputManagerServiceStubImpl's mirror HID, BLE/IIC and USB IDs.
+        // Do not suppress third-party keyboards or every 0x15d9 device.
+        return (vendorId == 5593 && productId >= 161 && productId <= 164)
+                || (vendorId == 10007 && productId == 25719)
+                || (vendorId == 48897 && productId == 64)
+                || (vendorId == 12806 && productId == 16380);
     }
 
