+++ b/core/java/android/widget/TouchpadFlingSpline.java
@@ -0,0 +1,196 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package android.widget;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.provider.Settings;
+
+/**
+ * Fling physics for the Xiaomi keyboard cover touchpad, as in stock HyperOS
+ * (OverScrollerForTouchpadStubImpl). The velocity decays exponentially with
+ * the friction and the pixel size from the stock /odm/etc/flick_profile.xml,
+ * which the device publishes in global settings, and the fling ends at the
+ * stop velocity. Only used while the last touch came from that touchpad.
+ *
+ * @hide
+ */
+final class TouchpadFlingSpline {
+
+    private static final String ENABLE_FLICK_OPTIMIZATION = "enable_flick_optimization";
+    private static final String IS_TOUCHPAD_SCROLL = "is_touchpad_scroll";
+    private static final String PARAM_PIXEL_SIZE = "param_pixel_size";
+    private static final String PARAM_FRICTION = "param_friction";
+    private static final String PARAM_FLICK_STOP_VEL_THRESHOLD = "param_flick_stop_vel_threshold";
+    private static final String PARAM_FLICK_START_VEL_THRESHOLD =
+            "param_flick_start_vel_threshold";
+
+    /** Per OverScroller: the settings and whether the last touch was on the touchpad. */
+    static final class Config {
+        private final ContentResolver mResolver;
+        private final boolean mEnabled;
+        private final float mPixelSize;
+        private final float mFriction;
+        private final float mStopVel;
+        private final float mStartVel;
+        private volatile boolean mTouchpadDown;
+
+        Config(Context context) {
+            ContentResolver resolver = null;
+            boolean enabled = false;
+            float pixelSize = 0.07368f;
+            float friction = 2.017f;
+            float stopVel = 1.934728f;
+            float startVel = 40.0f;
+            try {
+                resolver = context.getContentResolver();
+                enabled = Settings.Global.getInt(resolver, ENABLE_FLICK_OPTIMIZATION, 0) == 1;
+                if (enabled) {
+                    pixelSize = getPositive(resolver, PARAM_PIXEL_SIZE, pixelSize);
+                    friction = getPositive(resolver, PARAM_FRICTION, friction);
+                    stopVel = getPositive(resolver, PARAM_FLICK_STOP_VEL_THRESHOLD, stopVel);
+                    startVel = getPositive(resolver, PARAM_FLICK_START_VEL_THRESHOLD, startVel);
+                }
+            } catch (RuntimeException e) {
+                // No settings in this process; keep the platform physics.
+                enabled = false;
+            }
+            mResolver = resolver;
+            mEnabled = enabled;
+            mPixelSize = pixelSize;
+            mFriction = friction;
+            mStopVel = stopVel;
+            mStartVel = startVel;
+        }
+
+        private static float getPositive(ContentResolver resolver, String key, float def) {
+            float value = Settings.Global.getFloat(resolver, key, def);
+            return value <= 0.0f ? def : value;
+        }
+
+        boolean isEnabled() {
+            return mEnabled;
+        }
+
+        /** Called when a fling starts, like stock OverScrollerForTouchpadStubImpl.fling(). */
+        void refreshTouchpadDown() {
+            try {
+                mTouchpadDown = Settings.Global.getInt(mResolver, IS_TOUCHPAD_SCROLL, 0) == 1;
+            } catch (RuntimeException e) {
+                mTouchpadDown = false;
+            }
+        }
+
+        boolean isTouchpadDown() {
+            return mTouchpadDown;
+        }
+
+        float mmToPx(float mm) {
+            return mm / mPixelSize;
+        }
+
+        float pxToMm(float px) {
+            return mPixelSize * px;
+        }
+    }
+
+    /** Update results, as stock SplineOverScrollerForTouchpad.updateResults. */
+    boolean mUpdated;
+    float mCurrVel;
+    int mCurrPosition;
+
+    private final Config mConfig;
+    private boolean mFinished = true;
+    private int mStartPosition;
+    private float mStartVel;
+    private float mTotalDeltaVel;
+    private int mTotalDistance;
+    private int mTotalDuration;
+    private boolean mAdjusted;
+    private int mAdjustedDistance;
+
+    TouchpadFlingSpline(Config config) {
+        mConfig = config;
+    }
+
+    boolean isEnabled() {
+        return mConfig.isEnabled() && mConfig.isTouchpadDown();
+    }
+
+    float getFlingVelThreshold() {
+        return mConfig.mmToPx(mConfig.mStartVel);
+    }
+
+    void fling(int start, float vel) {
+        mAdjusted = false;
+        mAdjustedDistance = 0;
+        if (Math.abs(vel) > getFlingVelThreshold()) {
+            mStartVel = vel;
+            mTotalDeltaVel = Math.signum(vel)
+                    * (Math.abs(vel) - Math.abs(mConfig.mmToPx(mConfig.mStopVel)));
+            mTotalDuration = getSplineFlingDuration((int) vel);
+            mStartPosition = start;
+            mTotalDistance = (int) (Math.signum(vel) * getSplineFlingDistance((int) vel));
+            mFinished = false;
+            return;
+        }
+        mStartVel = 0.0f;
+        mTotalDeltaVel = 0.0f;
+        mTotalDuration = 0;
+        mStartPosition = 0;
+        mTotalDistance = 0;
+        mFinished = true;
+    }
+
+    /** Returns false when there is nothing to update; results are in the fields. */
+    boolean update(long currentDuration, float currVel) {
+        mUpdated = false;
+        if (currVel == 0.0f || mFinished) {
+            return false;
+        }
+        float stopVel = mConfig.mmToPx(mConfig.mStopVel);
+        if (Math.abs(currVel) <= stopVel) {
+            mCurrVel = Math.signum(currVel) * stopVel;
+            mFinished = true;
+        } else {
+            float vel = mConfig.mmToPx((float) (Math.abs(mConfig.pxToMm(mStartVel))
+                    * Math.exp((-mConfig.mFriction * currentDuration) / 1000.0f)));
+            mCurrVel = Math.signum(currVel) * vel;
+        }
+        float deltaVel = mStartVel - mCurrVel;
+        int deltaDistance = (int) (mTotalDistance * (deltaVel / mTotalDeltaVel));
+        if (mAdjusted) {
+            if (Math.abs(deltaDistance) > Math.abs(mAdjustedDistance)) {
+                deltaDistance = mAdjustedDistance;
+                mFinished = true;
+            }
+        } else if (mFinished || Math.abs(deltaDistance) > Math.abs(mTotalDistance)) {
+            deltaDistance = mTotalDistance;
+            mFinished = true;
+        }
+        mCurrPosition = mStartPosition + deltaDistance;
+        mUpdated = true;
+        return true;
+    }
+
+    double getSplineFlingDistance(int vel) {
+        float distance = mConfig.mmToPx(
+                (Math.abs(mConfig.pxToMm(vel)) - mConfig.mStopVel) / mConfig.mFriction);
+        mTotalDistance = (int) (Math.signum(vel) * distance);
+        return distance;
+    }
+
+    int getSplineFlingDuration(int vel) {
+        mTotalDuration = (int) ((-1.0f / mConfig.mFriction)
+                * Math.log(mConfig.mStopVel / Math.abs(mConfig.pxToMm(vel))) * 1000.0d);
+        return mTotalDuration;
+    }
+
+    int adjustDuration(int newDistance) {
+        mAdjusted = true;
+        mAdjustedDistance = newDistance;
+        return mTotalDuration;
+    }
+}
