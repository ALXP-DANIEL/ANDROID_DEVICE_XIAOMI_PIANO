+    void setPenLaserDrawingDevice(int32_t deviceId) {
+        if (deviceId < 0) {
+            mPenLaserDrawingDevice.store(-1, std::memory_order_release);
+            mPenLaserDrawingExpiryNs.store(0, std::memory_order_release);
+            return;
+        }
+        const auto now = std::chrono::steady_clock::now().time_since_epoch();
+        const auto expiry = std::chrono::duration_cast<std::chrono::nanoseconds>(now).count() +
+                5000000000LL;
+        mPenLaserDrawingExpiryNs.store(expiry, std::memory_order_release);
+        mPenLaserDrawingDevice.store(deviceId, std::memory_order_release);
+    }
     void setMouseScalingEnabled(ui::LogicalDisplayId displayId, bool enabled);
     void setMouseReverseVerticalScrollingEnabled(bool enabled);
