+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.input;
+
+/** Fail-open monotonic heartbeat lease for the native pen interception hot path. */
+final class PianoPenLaserLease {
+    static boolean accepts(boolean active, int selectedDevice, int incomingDevice, long now, long heartbeat) {
+        return active && selectedDevice >= 0 && selectedDevice == incomingDevice &&
+                now >= heartbeat && now - heartbeat <= 5000;
+    }
+
+    /** Short, device-specific drain after explicit laser shutdown; never permanent. */
+    static boolean suppressesRecentlyStopped(int stoppedDevice, int incomingDevice,
+            long now, long stoppedAt) {
+        return stoppedDevice >= 0 && stoppedDevice == incomingDevice &&
+                now >= stoppedAt && now - stoppedAt <= 1500;
+    }
+}
