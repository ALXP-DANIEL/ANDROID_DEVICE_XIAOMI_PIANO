diff --git a/fscryptpolicyclone.c b/fscryptpolicyclone.c
new file mode 100644
index 0000000..0909f06
--- /dev/null
+++ b/fscryptpolicyclone.c
@@ -0,0 +1,341 @@
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/fs.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <dirent.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static int verify_directory(const char *path, struct stat *st)
+{
+    if (lstat(path, st) != 0) {
+        fprintf(stderr,
+                "ERROR: lstat(%s): %s\n",
+                path,
+                strerror(errno));
+        return 0;
+    }
+
+    if (!S_ISDIR(st->st_mode)) {
+        fprintf(stderr,
+                "ERROR: not a directory: %s\n",
+                path);
+        return 0;
+    }
+
+    return 1;
+}
+
+static int directory_is_empty(const char *path)
+{
+    DIR *dir = opendir(path);
+
+    if (!dir) {
+        fprintf(stderr,
+                "ERROR: opendir(%s): %s\n",
+                path,
+                strerror(errno));
+        return -1;
+    }
+
+    struct dirent *entry;
+
+    while ((entry = readdir(dir)) != NULL) {
+        if (!strcmp(entry->d_name, ".") ||
+            !strcmp(entry->d_name, "..")) {
+            continue;
+        }
+
+        closedir(dir);
+        return 0;
+    }
+
+    closedir(dir);
+    return 1;
+}
+
+static int read_policy_v2(const char *path,
+                          struct fscrypt_policy_v2 *policy)
+{
+    int fd = open(path,
+                  O_DIRECTORY |
+                  O_RDONLY |
+                  O_NOFOLLOW |
+                  O_CLOEXEC);
+
+    if (fd < 0) {
+        fprintf(stderr,
+                "ERROR: open(%s): %s\n",
+                path,
+                strerror(errno));
+        return 0;
+    }
+
+    struct fscrypt_get_policy_ex_arg arg;
+    memset(&arg, 0, sizeof(arg));
+
+    arg.policy_size = sizeof(arg.policy);
+
+    if (ioctl(fd,
+              FS_IOC_GET_ENCRYPTION_POLICY_EX,
+              &arg) != 0) {
+        int saved_errno = errno;
+        close(fd);
+
+        fprintf(stderr,
+                "ERROR: GET policy for %s: %s (errno=%d)\n",
+                path,
+                strerror(saved_errno),
+                saved_errno);
+        return 0;
+    }
+
+    close(fd);
+
+    if (arg.policy.v2.version != 2) {
+        fprintf(stderr,
+                "ERROR: %s uses unexpected fscrypt policy version %u\n",
+                path,
+                (unsigned)arg.policy.v2.version);
+        return 0;
+    }
+
+    memcpy(policy,
+           &arg.policy.v2,
+           sizeof(*policy));
+
+    return 1;
+}
+
+static int probe_policy(const char *path,
+                        int *has_policy)
+{
+    int fd = open(path,
+                  O_DIRECTORY |
+                  O_RDONLY |
+                  O_NOFOLLOW |
+                  O_CLOEXEC);
+
+    if (fd < 0) {
+        fprintf(stderr,
+                "ERROR: open(%s): %s\n",
+                path,
+                strerror(errno));
+        return 0;
+    }
+
+    struct fscrypt_get_policy_ex_arg arg;
+    memset(&arg, 0, sizeof(arg));
+
+    arg.policy_size = sizeof(arg.policy);
+
+    errno = 0;
+
+    int rc = ioctl(fd,
+                   FS_IOC_GET_ENCRYPTION_POLICY_EX,
+                   &arg);
+
+    int saved_errno = errno;
+
+    close(fd);
+
+    if (rc == 0) {
+        *has_policy = 1;
+        return 1;
+    }
+
+    if (saved_errno == ENODATA) {
+        *has_policy = 0;
+        return 1;
+    }
+
+    fprintf(stderr,
+            "ERROR: policy probe for %s: %s (errno=%d)\n",
+            path,
+            strerror(saved_errno),
+            saved_errno);
+
+    return 0;
+}
+
+static int set_policy_v2(const char *path,
+                         const struct fscrypt_policy_v2 *policy)
+{
+    int fd = open(path,
+                  O_DIRECTORY |
+                  O_RDONLY |
+                  O_NOFOLLOW |
+                  O_CLOEXEC);
+
+    if (fd < 0) {
+        fprintf(stderr,
+                "ERROR: open(%s): %s\n",
+                path,
+                strerror(errno));
+        return 0;
+    }
+
+    if (ioctl(fd,
+              FS_IOC_SET_ENCRYPTION_POLICY,
+              policy) != 0) {
+        int saved_errno = errno;
+        close(fd);
+
+        fprintf(stderr,
+                "ERROR: SET policy for %s: %s (errno=%d)\n",
+                path,
+                strerror(saved_errno),
+                saved_errno);
+
+        return 0;
+    }
+
+    close(fd);
+    return 1;
+}
+
+static void print_hex(const uint8_t *bytes,
+                      size_t length)
+{
+    size_t i;
+
+    for (i = 0; i < length; ++i) {
+        printf("%02x", bytes[i]);
+    }
+
+    putchar('\n');
+}
+
+static void print_policy(const char *label,
+                         const struct fscrypt_policy_v2 *policy)
+{
+    printf(
+        "%s version=%u contents_mode=%u filenames_mode=%u flags=0x%02x\n",
+        label,
+        (unsigned)policy->version,
+        (unsigned)policy->contents_encryption_mode,
+        (unsigned)policy->filenames_encryption_mode,
+        (unsigned)policy->flags
+    );
+
+    printf("%s key_identifier=", label);
+
+    print_hex(
+        policy->master_key_identifier,
+        sizeof(policy->master_key_identifier)
+    );
+}
+
+int main(int argc, char **argv)
+{
+    if (argc != 3) {
+        fprintf(
+            stderr,
+            "usage: %s SOURCE DEST\n"
+            "\n"
+            "SOURCE must already have an fscrypt V2 policy.\n"
+            "DEST must exist, be empty, and have no policy.\n",
+            argv[0]
+        );
+
+        return 2;
+    }
+
+    const char *source = argv[1];
+    const char *dest   = argv[2];
+
+    struct stat source_stat;
+    struct stat dest_stat;
+
+    if (!verify_directory(source, &source_stat) ||
+        !verify_directory(dest, &dest_stat)) {
+        return 3;
+    }
+
+    if (source_stat.st_dev == dest_stat.st_dev &&
+        source_stat.st_ino == dest_stat.st_ino) {
+        fprintf(stderr,
+                "ERROR: SOURCE and DEST are the same directory\n");
+        return 4;
+    }
+
+    if (source_stat.st_dev != dest_stat.st_dev) {
+        fprintf(stderr,
+                "ERROR: SOURCE and DEST are on different filesystems\n");
+        return 5;
+    }
+
+    int empty = directory_is_empty(dest);
+
+    if (empty < 0) {
+        return 6;
+    }
+
+    if (!empty) {
+        fprintf(stderr,
+                "ERROR: destination is not empty: %s\n",
+                dest);
+        return 7;
+    }
+
+    int has_policy = 0;
+
+    if (!probe_policy(dest, &has_policy)) {
+        return 8;
+    }
+
+    if (has_policy) {
+        fprintf(stderr,
+                "ERROR: destination already has an fscrypt policy\n");
+        return 9;
+    }
+
+    struct fscrypt_policy_v2 source_policy;
+    memset(&source_policy, 0, sizeof(source_policy));
+
+    if (!read_policy_v2(source, &source_policy)) {
+        return 10;
+    }
+
+    puts("SOURCE policy:");
+    print_policy("  ", &source_policy);
+
+    printf(
+        "Applying exact policy struct:\n"
+        "  %s -> %s\n",
+        source,
+        dest
+    );
+
+    if (!set_policy_v2(dest, &source_policy)) {
+        return 11;
+    }
+
+    struct fscrypt_policy_v2 dest_policy;
+    memset(&dest_policy, 0, sizeof(dest_policy));
+
+    if (!read_policy_v2(dest, &dest_policy)) {
+        fprintf(stderr,
+                "ERROR: destination policy cannot be read back\n");
+        return 12;
+    }
+
+    puts("DEST readback policy:");
+    print_policy("  ", &dest_policy);
+
+    if (memcmp(&source_policy,
+               &dest_policy,
+               sizeof(source_policy)) != 0) {
+        fprintf(stderr,
+                "ERROR: destination policy struct differs from source\n");
+        return 13;
+    }
+
+    puts("POLICY_STRUCT_COMPARE=PASS");
+    puts("FSCRYPT_POLICY_CLONE=PASS");
+
+    return 0;
+}
