+    // key upgrade leaves behind: the same wrapped payload re-bound under a new
+    // KeyMint blob. Either blob may therefore be the one this TEE state will
+    // open, and trying only the live one gives up a working key for no reason.
+    //
+    // This is read-only. Nothing in /metadata is written, renamed or deleted,
+    // and the live blob is left exactly as found even when the backup is the one
+    // that works.
+    if (!opHandle) {
+        auto backup_blob_file = dir + "/../key_back/" + kFn_keymaster_key_blob;
+        std::string backup_blob;
+        if (android::base::ReadFileToString(backup_blob_file, &backup_blob) &&
+            backup_blob != blob) {
+            LOG(WARNING) << "begin() failed on " << blob_file << "; trying the stock backup blob "
+                         << backup_blob_file << " read-only";
+            opHandle = keystore.begin(backup_blob, inParams, outParams);
+            if (opHandle) {
+                LOG(INFO) << "The stock backup blob opened; the live blob is left unchanged";
+            } else {
+                LOG(ERROR) << "The stock backup blob did not open either";
+            }
+        }
+    }
+
     if (!opHandle) return opHandle;
 
     // If key blob wasn't upgraded, nothing left to do.
