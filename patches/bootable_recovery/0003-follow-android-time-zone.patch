 {
 	string TZ = GetStrValue(TW_TIME_ZONE_VAR);
@@ -996,6 +1109,35 @@ void DataManager::ReadSettingsFile(void)
 	Output_Version();
 	PartitionManager.Mount_All_Storage();
 	update_tz_environment_variables();
+
+	// Follow the installed system's time zone unless the saved settings could
+	// actually hold the user's latest choice. On piano the settings file is on
+	// read-only persist: an old one survives from before persist was made
+	// read-only, carrying the US Central default, and nothing chosen in the UI
+	// can ever replace it - so every boot came back to the wrong zone. An
+	// unwritable file is treated as stale. A zone chosen in the UI still takes
+	// over for the session, because that path calls
+	// update_tz_environment_variables() again with the chosen value.
+	if (!TWFunc::Path_Exists(settings_file) || access(settings_file, W_OK) != 0) {
+		std::string android_tz = Android_Time_Zone();
+		const char *origin = "the user's choice";
+		if (android_tz.empty()) {
+			android_tz = Rom_Default_Time_Zone();
+			origin = "the ROM default";
+		}
+		for (char c : android_tz) {
+			if (!isalnum((unsigned char)c) && c != '/' && c != '_' && c != '-' && c != '+') {
+				android_tz.clear();
+				break;
+			}
+		}
+		if (!android_tz.empty()) {
+			LOGINFO("Settings cannot be saved; using the system time zone '%s' (%s)\n",
+				android_tz.c_str(), origin);
+			setenv("TZ", android_tz.c_str(), 1);
+			tzset();
+		}
+	}
 	TWFunc::Set_Brightness(GetStrValue("tw_brightness"));
 }
 
