diff --git a/twrp.cpp b/twrp.cpp
index 5e1fb91..24901ef 100644
--- a/twrp.cpp
+++ b/twrp.cpp
@@ -139,17 +139,31 @@ static void process_fastbootd_mode() {
 // The waits are bounded and non-fatal. If the stack does not come up, carrying on
 // gives the same failure as before rather than hanging the recovery, and the
 // timeout is logged so it cannot be mistaken for a crypto fault.
+//
+// The bounds are deliberately generous. The whole secure stack is started from
+// twrp.super.symlinks_created, so it is racing TWRP's own partition setup for
+// the same disk, and on a slow boot qseecomd needs longer than half a minute to
+// publish its listeners. A 30s bound lost that race on roughly one boot in
+// twenty, and the cost was not a slow decrypt but a dead session:
+//
+//   piano: QSEE listeners did not register within 30s
+//   Unable to decrypt metadata encryption
+//
+// after which recovery never retries the metadata layer and /data stays
+// encrypted until the user reboots. A property wait that succeeds returns
+// immediately, so a larger bound costs a healthy boot nothing and only changes
+// how long an unhealthy one is given before it is declared failed.
 static void piano_wait_for_secure_stack() {
 	using namespace std::chrono_literals;
 
-	if (!android::base::WaitForProperty("vendor.sys.listeners.registered", "true", 30s)) {
-		LOGERR("piano: QSEE listeners did not register within 30s; decryption will likely fail\n");
+	if (!android::base::WaitForProperty("vendor.sys.listeners.registered", "true", 90s)) {
+		LOGERR("piano: QSEE listeners did not register within 90s; decryption will likely fail\n");
 		return;
 	}
 	LOGINFO("piano: QSEE listeners registered\n");
 
-	if (!android::base::WaitForProperty("init.svc.vendor.keymint", "running", 15s)) {
-		LOGERR("piano: KeyMint HAL did not start within 15s; decryption will likely fail\n");
+	if (!android::base::WaitForProperty("init.svc.vendor.keymint", "running", 30s)) {
+		LOGERR("piano: KeyMint HAL did not start within 30s; decryption will likely fail\n");
 		return;
 	}
 	LOGINFO("piano: KeyMint HAL running\n");
