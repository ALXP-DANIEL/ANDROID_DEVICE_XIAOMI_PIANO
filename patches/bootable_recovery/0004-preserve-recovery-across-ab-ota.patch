+// Back up dedicated A/B recovery before update_engine can replace it.
+static std::string Recovery_Block_Device(const std::string& slot) {
+	if (slot != "A" && slot != "B") return {};
+	return "/dev/block/bootdevice/by-name/recovery_" + std::string(1, tolower(slot[0]));
+}
+
+static std::string Current_Boot_Slot() {
+#ifdef AB_OTA_UPDATER
+	const auto module = android::hal::BootControlClient::WaitForService();
+	if (module == nullptr) return {};
+	const int32_t slot = module->GetCurrentSlot();
+	if (slot == 0) return "A";
+	if (slot == 1) return "B";
+	return {};
+#else
+	return PartitionManager.Get_Active_Slot_Display();
+#endif
+}
+
+static bool Copy_Recovery_Image(int source, int destination, uint64_t bytes) {
+	std::vector<char> buffer(1024 * 1024);
+	while (bytes != 0) {
+		const size_t amount = std::min<uint64_t>(buffer.size(), bytes);
+		const ssize_t count = TEMP_FAILURE_RETRY(read(source, buffer.data(), amount));
+		if (count <= 0) return false;
+		ssize_t written = 0;
+		while (written < count) {
+			const ssize_t result = TEMP_FAILURE_RETRY(write(destination, buffer.data() + written, count - written));
+			if (result <= 0) return false;
+			written += result;
+		}
+		bytes -= count;
+	}
+	return fsync(destination) == 0;
+}
+
+static bool Verify_Recovery_Image(const std::string& image, const std::string& block, uint64_t bytes) {
+	android::base::unique_fd source(open(image.c_str(), O_RDONLY | O_CLOEXEC));
+	android::base::unique_fd destination(open(block.c_str(), O_RDONLY | O_CLOEXEC));
+	if (source.get() < 0 || destination.get() < 0) return false;
+	std::vector<char> expected(1024 * 1024), actual(1024 * 1024);
+	while (bytes != 0) {
+		const size_t amount = std::min<uint64_t>(expected.size(), bytes);
+		if (TEMP_FAILURE_RETRY(read(source.get(), expected.data(), amount)) != static_cast<ssize_t>(amount) ||
+		    TEMP_FAILURE_RETRY(read(destination.get(), actual.data(), amount)) != static_cast<ssize_t>(amount) ||
+		    memcmp(expected.data(), actual.data(), amount) != 0) return false;
+		bytes -= amount;
+	}
+	return true;
+}
+
+static bool Backup_Recovery_Image(const std::string& slot, std::string* backup, uint64_t* size) {
+	const std::string block = Recovery_Block_Device(slot);
+	if (block.empty()) return false;
+	android::base::unique_fd source(open(block.c_str(), O_RDONLY | O_CLOEXEC));
+	if (source.get() < 0 || ioctl(source.get(), BLKGETSIZE64, size) != 0 || *size == 0 || *size > 256 * 1024 * 1024)
+		return false;
+	char path[] = "/tmp/twrp-recovery-XXXXXX";
+	android::base::unique_fd destination(mkstemp(path));
+	if (destination.get() < 0) return false;
+	*backup = path;
+	if (!Copy_Recovery_Image(source.get(), destination.get(), *size)) {
+		unlink(path);
+		backup->clear();
+		return false;
+	}
+	destination.reset();
+	if (Verify_Recovery_Image(*backup, block, *size)) return true;
+	unlink(path);
+	backup->clear();
+	return false;
+}
+
+static bool Restore_Recovery_Image(const std::string& backup, const std::string& slot, uint64_t size) {
+	const std::string block = Recovery_Block_Device(slot);
+	if (block.empty()) return false;
+	android::base::unique_fd source(open(backup.c_str(), O_RDONLY | O_CLOEXEC));
+	android::base::unique_fd destination(open(block.c_str(), O_WRONLY | O_CLOEXEC));
+	if (source.get() < 0 || destination.get() < 0) return false;
+	uint64_t block_size = 0;
+	if (ioctl(destination.get(), BLKGETSIZE64, &block_size) != 0 || block_size != size) return false;
+	if (!Copy_Recovery_Image(source.get(), destination.get(), size)) return false;
+	destination.reset();
+	return Verify_Recovery_Image(backup, block, size);
+}
