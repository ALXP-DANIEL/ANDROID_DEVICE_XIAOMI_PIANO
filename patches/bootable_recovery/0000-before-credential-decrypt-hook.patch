+// Metadata encryption creates this mapper for /data in
+// fscrypt_mount_metadata_encrypted(). Formatting must operate on the raw
+// backing device, so remove it only after proving it is the sole holder.
+static bool RemoveDataMetadataEncryptionMapper(const std::string& raw_device) {
+    constexpr char kMapperName[] = "userdata";
+    auto& dm = android::dm::DeviceMapper::Instance();
+    if (dm.GetState(kMapperName) == android::dm::DmDeviceState::INVALID) return true;
+
+    std::error_code ec;
+    const auto raw_path = std::filesystem::canonical(raw_device, ec);
+    if (ec) {
+        LOGERR("Unable to resolve raw /data device '%s': %s\n", raw_device.c_str(),
+               ec.message().c_str());
+        return false;
+    }
+
+    std::string mapper_path;
+    if (!dm.GetDmDevicePathByName(kMapperName, &mapper_path)) {
+        LOGERR("Unable to resolve metadata-encryption mapper '%s'.\n", kMapperName);
+        return false;
+    }
+    const std::string mapper_node = std::filesystem::path(mapper_path).filename();
+    const auto holders_path =
+            std::filesystem::path("/sys/class/block") / raw_path.filename() / "holders";
+
+    auto holder = std::filesystem::directory_iterator(holders_path, ec);
+    const auto holders_end = std::filesystem::directory_iterator();
+    if (ec || holder == holders_end) {
+        LOGERR("Refusing to remove '%s': it is not the verified holder of raw /data '%s'.\n",
+               kMapperName, raw_path.c_str());
+        return false;
+    }
+    const std::string holder_name = holder->path().filename();
+    if (holder_name != mapper_node) {
+        LOGERR("Refusing to format /data: raw device '%s' has unexpected holder '%s'.\n",
+               raw_path.c_str(), holder_name.c_str());
+        return false;
+    }
+    ++holder;
+    if (holder != holders_end) {
+        LOGERR("Refusing to format /data: raw device '%s' has more than one holder.\n",
+               raw_path.c_str());
+        return false;
+    }
+
+    if (!dm.DeleteDevice(kMapperName, std::chrono::seconds(1))) {
+        LOGERR("Unable to remove metadata-encryption mapper '%s'.\n", kMapperName);
+        return false;
+    }
+    holder = std::filesystem::directory_iterator(holders_path, ec);
+    if (ec) {
+        LOGERR("Unable to verify holders for raw /data '%s': %s\n", raw_path.c_str(),
+               ec.message().c_str());
+        return false;
+    }
+    if (holder != holders_end) {
+        LOGERR("Refusing to format /data: raw device '%s' is still held by '%s'.\n",
+               raw_path.c_str(), holder->path().filename().c_str());
+        return false;
+    }
+    return true;
+}
