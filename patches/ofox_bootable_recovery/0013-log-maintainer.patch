Name the maintainer in the startup log line

OF_MAINTAINER was only shown on the About page. Put it in the first line of
every recovery log so bug reports say whose build it is.

diff --git a/twrp.cpp b/twrp.cpp
--- a/twrp.cpp
+++ b/twrp.cpp
@@ -527,8 +527,8 @@
   	TWFunc::Reset_Clock();
 
   	DataManager::GetValue(FOX_COMPATIBILITY_DEVICE, Fox_Current_Device);
-	printf("Starting OrangeFox Recovery %s [%s, core: %s] (built on %s for %s [dev_ver: %s (branch: %s)]; pid %d)\n",
-		FOX_BUILD, FOX_VARIANT, FOX_MAIN_VERSION_STR, fox_build_date.c_str(), Fox_Current_Device.c_str(), FOX_CURRENT_DEV_STR, OF_CURRENT_BRANCH, getpid());
+	printf("Starting OrangeFox Recovery %s [%s, core: %s] (built on %s for %s [dev_ver: %s (branch: %s)]; maintainer: %s; pid %d)\n",
+		FOX_BUILD, FOX_VARIANT, FOX_MAIN_VERSION_STR, fox_build_date.c_str(), Fox_Current_Device.c_str(), FOX_CURRENT_DEV_STR, OF_CURRENT_BRANCH, OF_MAINTAINER, getpid());
 
 	// refresh the specific device codename if we have a generic unified codename
 	TWFunc::Fox_Set_Current_Device_CodeName();
