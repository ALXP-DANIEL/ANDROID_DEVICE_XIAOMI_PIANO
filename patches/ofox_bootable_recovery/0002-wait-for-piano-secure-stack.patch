Wait for the piano secure stack (QSEE listeners, KeyMint) before setting up
partitions, and tell init when partitions are ready. Drop the startup
copySqliteDb(): vold synchronises the database at decrypt time.

diff --git a/twrp.cpp b/twrp.cpp
index ad3ead437..208d12442 100644
--- a/twrp.cpp
+++ b/twrp.cpp
@@ -134,6 +134,19 @@ static void process_fastbootd_mode() {
 		property_set("ro.orangefox.fastbootd", "0");
 }
 
+static void piano_wait_for_secure_stack() {
+    using namespace std::chrono_literals;
+    if (!android::base::WaitForProperty("vendor.sys.listeners.registered", "true", 90s)) {
+        LOGERR("piano: QSEE listeners did not register within 90s\n");
+        return;
+    }
+    if (!android::base::WaitForProperty("init.svc.vendor.keymint", "running", 30s)) {
+        LOGERR("piano: KeyMint HAL did not start within 30s\n");
+        return;
+    }
+    LOGINFO("piano: secure stack ready\n");
+}
+
 static void process_recovery_mode(twrpAdbBuFifo* adb_bu_fifo, bool skip_decryption) {
 	char crash_prop_val[PROPERTY_VALUE_MAX];
 	int crash_counter;
@@ -248,9 +261,6 @@ static void process_recovery_mode(twrpAdbBuFifo* adb_bu_fifo, bool skip_decrypti
   	property_set("orangefox.adb.status", "0");
 #endif
 
-#ifdef TW_INCLUDE_CRYPTO
-	android::keystore::copySqliteDb();
-#endif
 	Decrypt_Page(skip_decryption, datamedia);
 
 	// Check for and load custom theme if present
@@ -535,6 +545,8 @@ int main(int argc, char **argv) {
 		return -1;
 	}
 
+	property_set("vendor.piano.partitions_ready", "1");
