Label stock HyperOS as "HyperOS ROM" on the welcome screen

Virtual A/B devices are always vanilla builds, so OrangeFox never detects
MIUI/HyperOS and printed "Custom ROM" on stock HyperOS. Recognise the
HyperOS incremental ("OS3.0.x", "OS4.0.x") for the label only; the MIUI
features stay disabled.

diff --git a/gui/theme/common/languages/en.xml b/gui/theme/common/languages/en.xml
index d798317..9abed92 100644
--- a/gui/theme/common/languages/en.xml
+++ b/gui/theme/common/languages/en.xml
@@ -1014,6 +1014,7 @@
 		<string name="fox_kernel">* Kernel:     {1}</string>
 		<string name="fox_miui_rom">* MIUI ROM (SDK:{1}, {2})</string>
 		<string name="fox_custom_rom">* Custom ROM (SDK:{1}, {2})</string>
+		<string name="fox_hyperos_rom">* HyperOS ROM (SDK:{1}, {2})</string>
 		<string name="fox_fingerprint">* Fingerprint: {1}</string>
 		<string name="fox_no_rom">* No ROM.</string>
 		
diff --git a/twrp-functions.cpp b/twrp-functions.cpp
index ef35ae7..4968cec 100755
--- a/twrp-functions.cpp
+++ b/twrp-functions.cpp
@@ -2647,6 +2647,13 @@ int TWFunc::Check_MIUI_Treble(void)
   	     Fox_Current_ROM_IsMIUI = 1;
   	     gui_msg(Msg("fox_miui_rom=* MIUI ROM (SDK:{1}, {2})")(rom_sdk)(sdknum_to_text(rom_sdk).c_str()));
           } 
+  	else if (incr_version.rfind("OS", 0) == 0)
+     	  {
+     	     // Stock Xiaomi HyperOS (incremental "OS3.0.x" / "OS4.0.x"). On
+     	     // Virtual A/B OrangeFox is a vanilla build, so the MIUI features
+     	     // stay off; only the label changes.
+     	     gui_msg(Msg("fox_hyperos_rom=* HyperOS ROM (SDK:{1}, {2})")(rom_sdk)(sdknum_to_text(rom_sdk).c_str()));
+    	  }
   	else
      	  {
      	     gui_msg(Msg("fox_custom_rom=* Custom ROM (SDK:{1}, {2})")(rom_sdk)(sdknum_to_text(rom_sdk).c_str()));
