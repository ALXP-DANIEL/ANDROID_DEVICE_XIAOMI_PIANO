service vendor.fingerprint-default /vendor/bin/hw/android.hardware.biometrics.fingerprint-service.xiaomi.sm8750
    interface aidl android.hardware.biometrics.fingerprint.IFingerprint/default
    interface aidl vendor.qti.hardware.fingerprint.IQfpExtendedFingerprint/default
    # "class hal" causes a race condition on some devices due to files created
    # in /data. As a workaround, postpone startup until later in boot once
    # /data is mounted.
    class late_start
    user system
    group system drmrpc diag input uhid
    capabilities SYS_NICE WAKE_ALARM
    socket fpsensor_socket stream 0777 system system
    shutdown critical
