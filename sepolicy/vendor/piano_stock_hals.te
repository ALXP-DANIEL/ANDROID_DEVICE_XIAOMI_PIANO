dontaudit hal_camera_default default_prop:file { read };

# The Xiaomi camera stack enumerates every system property; denying the
# unrelated ones is harmless, so keep them out of the log.
dontaudit hal_camera_default property_type:file r_file_perms;

# Xiaomi power daemon.
dontaudit hal_hypsys_vendor kmsg_device:chr_file r_file_perms;
