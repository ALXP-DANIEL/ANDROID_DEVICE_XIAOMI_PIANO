type hal_seaaudio_default, domain;
type hal_seaaudio_default_exec, exec_type, file_type, vendor_file_type;
type hal_seaaudio_service, hal_service_type, protected_service, service_manager_type;

binder_use(hal_seaaudio_default)
binder_use(hal_seaaudio_server)
hal_server_domain(hal_seaaudio_default, hal_seaaudio)
init_daemon_domain(hal_seaaudio_default)

allow hal_seaaudio_client hal_seaaudio_server:binder { call transfer };
allow hal_seaaudio_client hal_seaaudio_server:fd *;
allow hal_seaaudio_client hal_seaaudio_service:service_manager find;
allow hal_seaaudio_default dmabuf_system_heap_device:chr_file rw_file_perms;
allow hal_seaaudio_default hal_system_suspend_service:service_manager find;
allow hal_seaaudio_server hal_seaaudio_client:binder { call transfer };
allow hal_seaaudio_server hal_seaaudio_client:fd *;
allow hal_seaaudio_server hal_seaaudio_service:service_manager { add find };
