type hal_idmanager_default, domain;
type hal_idmanager_default_exec, exec_type, file_type, vendor_file_type;
type hal_idmanager_service, hal_service_type, protected_service, service_manager_type;

init_daemon_domain(hal_idmanager_default)
hal_server_domain(hal_idmanager_default, hal_idmanager)
hal_attribute_service(hal_idmanager, hal_idmanager_service)
binder_use(hal_idmanager_default)

hal_client_domain(platform_app, hal_idmanager)
hal_client_domain(system_app, hal_idmanager)
hal_client_domain(hal_idmanager_default, hal_misyscore)

allow hal_idmanager_default block_device:dir r_dir_perms;
allow hal_idmanager_default secinfo_block_device:blk_file rw_file_perms;
allow hal_idmanager_default tee_device:chr_file rw_file_perms;
allow hal_idmanager_default vendor_custom_ab_block_device:dir r_dir_perms;
allow hal_idmanager_default vendor_dmabuf_qseecom_heap_device:chr_file r_file_perms;
allow hal_idmanager_default vendor_dmabuf_qseecom_ta_heap_device:chr_file r_file_perms;
allow hal_idmanager_default vendor_ese_gpio_device:chr_file rw_file_perms;

get_prop(hal_idmanager_default, boot_status_prop)
get_prop(hal_idmanager_default, vendor_cpuid_prop)
get_prop(hal_idmanager_default, vendor_deviceid_prop)
get_prop(hal_idmanager_default, vendor_system_prop)
get_prop(hal_idmanager_default, vendor_tee_listener_prop)
set_prop(hal_idmanager_default, vendor_ese_prop)
set_prop(hal_idmanager_default, vendor_payment_security_prop)
