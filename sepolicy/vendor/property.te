# Vendor-owned status intentionally set by the trusted system-side authentication app.
vendor_public_prop(vendor_security_devauth_keyboard_connected_prop)
# Stock MiDevAuth writes this vendor status from a system_ext app. Mark
# only this cross-partition property as a core extension; retain vendor ownership.
typeattribute vendor_security_devauth_keyboard_connected_prop extended_core_property_type;
