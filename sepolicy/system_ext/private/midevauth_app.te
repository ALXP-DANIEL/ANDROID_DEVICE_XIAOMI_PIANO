# Original Xiaomi-signed MiDevAuth, selected by signer and package in mac_permissions.
typeattribute midevauth_app coredomain;
app_domain(midevauth_app)
net_domain(midevauth_app)
binder_use(midevauth_app)
# PianoParts is the client of the app's bound authentication service.
binder_call(system_app, midevauth_app)
